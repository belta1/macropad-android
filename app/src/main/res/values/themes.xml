<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Macropad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0E1118</item>
        <item name="android:colorAccent">#FF4F8CFF</item>
        <item name="android:statusBarColor">#FF0E1118</item>
        <item name="android:navigationBarColor">#FF06070A</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:editTextStyle">@style/Macropad.TextField</item>
    </style>

    <style name="Theme.Macropad.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:colorAccent">#FF4F8CFF</item>
        <item name="android:colorBackground">#FF181B23</item>
        <item name="android:textColorPrimary">#FFF2F4F8</item>
        <item name="android:textColorSecondary">#FF8C94A6</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:windowTitleStyle">@style/Macropad.DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/Macropad.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Macropad.DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Macropad.DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Macropad.DialogButton.Primary</item>
        <item name="android:listViewStyle">@style/Macropad.DialogList</item>
        <item name="android:editTextStyle">@style/Macropad.TextField</item>
    </style>

    <style name="Macropad.TextField" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/text_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">#FFF2F4F8</item>
        <item name="android:textColorHint">#FF6B7385</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Macropad.DialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#FFF2F4F8</item>
    </style>

    <style name="Macropad.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:background">@drawable/dialog_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FF8FB4FF</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Macropad.DialogButton.Primary">
        <item name="android:background">@drawable/dialog_button_primary</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="Macropad.DialogList" parent="android:Widget.Material.ListView">
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:divider">@null</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
    </style>
</resources>
