<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: recessed into the dialog like the plate under the keys; outlined while typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF18191B" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFEDEAE3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF18191B" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#2BFFFFFF" />
        </shape>
    </item>
</selector>
