<?xml version="1.0" encoding="utf-8"?>
<!-- Text button in dialogs: a rounded highlight when pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item android:id="@android:id/mask">
        <inset android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFFFF" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</ripple>
