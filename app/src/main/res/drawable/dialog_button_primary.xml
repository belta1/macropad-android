<?xml version="1.0" encoding="utf-8"?>
<!-- Main dialog button (OK, Save…): a filled accent pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <inset android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF4F8CFF" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
</ripple>
