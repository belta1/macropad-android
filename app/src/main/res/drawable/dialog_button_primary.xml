<?xml version="1.0" encoding="utf-8"?>
<!-- Main dialog button (OK, Save…): warm white with dark ink, the brightest thing in the dialog. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <inset android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#FFEDEAE3" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</ripple>
